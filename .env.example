# Credentials for the Stripe and PayPal sandboxes, used by `make live` and
# `make test-live`. Copy to .env and fill in; .env is never committed.

# Stripe: Dashboard > Developers > API keys, in test mode.
STRIPE_SECRET_KEY=sk_test_...
# Printed by `make stripe-webhook-secret` once STRIPE_SECRET_KEY is set.
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal: developer.paypal.com > Apps & Credentials > Sandbox > your app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id of a webhook registered on the same sandbox app.
PAYPAL_WEBHOOK_ID=
# Id (P-...) of the billing plan every PayPal subscription uses, created once
# in the sandbox: a regular cycle charged every 1 day, week, month or year.
PAYPAL_PLAN_ID=
